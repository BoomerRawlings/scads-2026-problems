{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphrag-discovery:record:1",
  "title": "Lossless public English plain-text source record",
  "description": "Input to validate_record. Runtime additionally enforces 1 MiB serialized size, exact UTF-8 hash equality, calendar validity, and bounded JSON depth/bytes. corpus_id may be injected from the request; if supplied it must match. Ingestion clocks are server-owned and cannot be supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "document_id", "version_id", "operation", "access_scope"],
  "properties": {
    "schema_version": {"const": "1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "event_id": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "version_id": {"$ref": "#/$defs/id"},
    "processing_version": {"const": "plain-text-v1"},
    "operation": {"enum": ["upsert", "withdraw"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 250000, "pattern": "\\S"},
    "content_sha256": {"$ref": "#/$defs/hash"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "source_uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
    "source_version_ref": {"$ref": "#/$defs/text"},
    "source_available_at": {"$ref": "#/$defs/nullableTimestamp", "default": null},
    "source_event_at": {"$ref": "#/$defs/nullableTimestamp"},
    "reference_time": {"$ref": "#/$defs/nullableTimestamp"},
    "source_timezone": {"$ref": "#/$defs/text"},
    "time_precision": {"$ref": "#/$defs/text"},
    "language": {"const": "en"},
    "rights_ref": {"$ref": "#/$defs/text"},
    "access_scope": {"const": "public"},
    "supersedes_version_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}], "default": null},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "metadata": {"$ref": "#/$defs/jsonValue"},
    "context": {"$ref": "#/$defs/jsonValue"},
    "qualifiers": {"type": "object", "$ref": "#/$defs/jsonValue", "properties": {"exclusive": {"type": "boolean"}}},
    "provenance_map": {"$ref": "#/$defs/jsonValue"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "upsert"}}},
      "then": {
        "required": ["processing_version", "text", "content_sha256", "source_sha256", "source_uri", "source_version_ref", "language", "rights_ref"],
        "properties": {"reason": false}
      },
      "else": {
        "required": ["reason"],
        "properties": {"processing_version": false, "text": false, "content_sha256": false, "source_sha256": false, "supersedes_version_id": false}
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$", "not": {"pattern": "[^A-Za-z0-9_.:-]"}},
    "hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$", "not": {"pattern": "-00:00$"}},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "jsonValue": {
      "description": "Finite JSON; runtime also limits maximum nesting depth to 8 and each complete field to 65536 UTF-8 JSON bytes.",
      "anyOf": [
        {"type": "null"}, {"type": "boolean"}, {"type": "number"},
        {"type": "string", "maxLength": 16384},
        {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "maxProperties": 64, "propertyNames": {"maxLength": 128}, "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  },
  "x-runtime-validation": [
    "Dates must be valid instants; output is UTC with six fractional digits and +00:00.",
    "Both upsert hashes equal SHA-256 of text encoded as exact UTF-8.",
    "supersedes_version_id cannot equal version_id.",
    "corpus_id equals the request corpus namespace.",
    "No unpaired Unicode surrogates or non-finite JSON values are accepted."
  ]
}
