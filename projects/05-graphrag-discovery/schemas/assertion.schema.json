{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphrag-discovery:assertion:1",
  "title": "Authored, source-grounded fixture assertion",
  "description": "Input to validate_assertion. Runtime additionally checks source identity, Unicode span bounds and exact text, endpoint grounding, interval ordering, and 1 MiB serialized size. This is not an extraction or truth-verification model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_id", "document_id", "version_id", "processing_version", "subject_id", "subject_label", "object_id", "object_label", "text", "start", "end", "modality", "temporal_status", "method"],
  "properties": {
    "schema_version": {"const": "1", "default": "1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "assertion_id": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "version_id": {"$ref": "#/$defs/id"},
    "processing_version": {"const": "plain-text-v1"},
    "subject_id": {"$ref": "#/$defs/id"},
    "subject_label": {"$ref": "#/$defs/label"},
    "object_id": {"$ref": "#/$defs/id"},
    "object_label": {"$ref": "#/$defs/label"},
    "text": {"type": "string", "minLength": 1, "maxLength": 250000},
    "start": {"type": "integer", "minimum": 0, "maximum": 249999},
    "end": {"type": "integer", "minimum": 1, "maximum": 250000},
    "modality": {"enum": ["reported", "planned", "negated"]},
    "valid_from": {"$ref": "#/$defs/nullableTimestamp", "default": null},
    "valid_to": {"$ref": "#/$defs/nullableTimestamp", "default": null},
    "temporal_status": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {"from": {"enum": ["known", "unknown"]}, "to": {"enum": ["known", "open", "unknown"]}}
    },
    "supersedes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}, "default": []},
    "method": {"enum": ["authored-fixture", "local-model-v1"]},
    "relation_group": {"$ref": "#/$defs/id", "description": "Authored fixture classification hint only; not inferred semantic equivalence or independent evidence."},
    "metadata": {"$ref": "#/$defs/jsonValue"},
    "context": {"$ref": "#/$defs/jsonValue"},
    "qualifiers": {"type": "object", "$ref": "#/$defs/jsonValue", "properties": {"exclusive": {"type": "boolean"}}}
  },
  "allOf": [
    {
      "if": {"properties": {"temporal_status": {"properties": {"from": {"const": "known"}}}}},
      "then": {"required": ["valid_from"], "properties": {"valid_from": {"$ref": "#/$defs/timestamp"}}},
      "else": {"properties": {"valid_from": {"type": "null"}}}
    },
    {
      "if": {"properties": {"temporal_status": {"properties": {"to": {"const": "known"}}}}},
      "then": {"required": ["valid_to"], "properties": {"valid_to": {"$ref": "#/$defs/timestamp"}}},
      "else": {"properties": {"valid_to": {"type": "null"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$", "not": {"pattern": "[^A-Za-z0-9_.:-]"}},
    "label": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$", "not": {"pattern": "-00:00$"}},
    "nullableTimestamp": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "jsonValue": {
      "description": "Finite JSON; runtime also limits maximum nesting depth to 8 and each complete field to 65536 UTF-8 JSON bytes.",
      "anyOf": [
        {"type": "null"}, {"type": "boolean"}, {"type": "number"},
        {"type": "string", "maxLength": 16384},
        {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "maxProperties": 64, "propertyNames": {"maxLength": 128}, "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  },
  "x-runtime-validation": [
    "Source must be a validated upsert. Corpus/document/version/processing fields match that record.",
    "0 <= start < end <= len(source.text); Python booleans and floats are not offsets.",
    "text equals source.text[start:end]; both endpoint labels occur literally in that span.",
    "Each known bound has a valid timezone-aware instant; unknown/open bounds have null dates.",
    "Known valid_to is strictly after known valid_from after UTC normalization.",
    "supersedes excludes this assertion's ID.",
    "No unpaired Unicode surrogates or non-finite JSON values are accepted."
  ]
}
