{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "title", "target", "summary", "findings", "conflicts", "media_observations", "limitations", "follow_up"],
  "properties": {
    "status": {"type": "string", "enum": ["complete", "needs_clarification", "insufficient_evidence"]},
    "title": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "evidence_ids", "qualification"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "qualification": {"type": "string"}
      }
    }},
    "conflicts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "predicate", "description", "evidence_ids"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }},
    "media_observations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "locator", "observation"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1}
      }
    }},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "follow_up": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
